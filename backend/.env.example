# Database (PostgreSQL URL, or leave blank to use local SQLite automatically)
DATABASE_URL=postgresql://jarvis:change-me@localhost:5432/jarvis

# Groq API Keys (comma-separated) for LLM + Whisper STT
GROQ_API_KEYS=gsk_your_key_1,gsk_your_key_2
# Optional path to local XLSX key pool
GROQ_KEYS_XLSX_PATH=

# Server Settings
HOST=0.0.0.0
PORT=8000
JARVIS_PUBLIC_URL=
JARVIS_SEED_ON_STARTUP=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
